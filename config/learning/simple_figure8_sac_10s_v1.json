{
  "schema": "simple_figure8_sac_10s_v1",
  "experiment_id": "simple_figure8_sac_10s_v1",
  "model_freeze": "MODEL_FREEZE_REMEASURED_GEOMETRY_PRE_MPPI",
  "simulator_config": "config/default.json",
  "initial_state_task_config": "config/tasks/canonical_whip_v1.json",
  "context_normalizer": "analytic_figure8_initial_state_v1",
  "seed": 42,
  "total_episodes": 1000000,
  "collection_batch": 2048,
  "episode_duration_s": 10.0,
  "control_dt_s": 0.1,
  "physics_dt_s": 0.01,
  "figure8": {
    "center": "settled_initial_cable_tip",
    "amplitude_x_m": 0.7,
    "amplitude_y_m": 0.5
  },
  "observation": {
    "context_dimensions": 83,
    "time_remaining_dimensions": 1,
    "dynamic_goal": "current forward Figure-8 reference point and tangent",
    "normalized_clip": 10.0
  },
  "action": {
    "dimensions": 6,
    "meaning": [
      "yaw-local acceleration x",
      "yaw-local acceleration y",
      "yaw-local acceleration z",
      "body roll rate",
      "body pitch rate",
      "body yaw rate"
    ],
    "maximum_acceleration_norm_m_s2": 10.0,
    "maximum_body_rate_rad_s": 4.0,
    "position_velocity_commands_reanchored_each_physics_step": true
  },
  "reported_success": {
    "name": "one_cycle_tracking_success",
    "minimum_completed_cycles": 1.0,
    "maximum_tracking_rmse_m": 0.10,
    "maximum_uav_speed_m_s": 3.0,
    "minimum_scene_height_m": 0.02,
    "finite_required": true,
    "note": "Reporting metric only; no success bonus is added to reward."
  },
  "reward": {
    "profile": "legacy_online_figure8_geometric_tracking_v1",
    "equation": "-(5000*mean(path_error^2) - 5*forward_progress_m + 0.5*mean(tip_accel^2)/100 + 0.0002*accel_effort + 0.05*accel_change + 80*speed_violation^2 + 100*ground_violation^2 + 1000*numerical_failure)",
    "tracking_weight": 5000.0,
    "path_progress_reward_weight": 5.0,
    "control_effort_weight": 0.0002,
    "control_smoothness_weight": 0.05,
    "tip_motion_smoothness_weight": 0.5,
    "speed_limit_weight": 80.0,
    "ground_safety_weight": 100.0,
    "ground_clearance_m": 0.02,
    "numerical_failure_penalty": 1000.0
  },
  "sac": {
    "hidden_dim": 256,
    "actor_lr": 0.0003,
    "critic_lr": 0.0003,
    "alpha_lr": 0.0003,
    "gamma": 0.99,
    "tau": 0.005,
    "initial_alpha": 0.2,
    "target_entropy": -6.0,
    "reward_scale_divisor": 10000.0,
    "replay_capacity_transitions": 1000000,
    "replay_minibatch": 4096,
    "initial_random_episodes": 20480,
    "updates_per_collection": 100,
    "gradient_clip": 10.0
  },
  "logging": {
    "checkpoint_every_episodes": 102400,
    "csv_every_collection": true,
    "print_every_collection": true
  },
  "separation": {
    "whip_code_modified": false,
    "whip_artifacts_modified": false,
    "separate_environment": "learning/figure8_sac_env.py",
    "separate_runner": "run_figure8_sac.py"
  },
  "prohibitions": {
    "cem": true,
    "demonstrations": true,
    "behavior_cloning": true,
    "protected_test": "fig8vertical_002",
    "hardware": true
  }
}
