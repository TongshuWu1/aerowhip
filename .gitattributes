# Auto detect text files and perform LF normalization
* text=auto

# Frozen scientific artifacts are byte-addressed by SHA-256 manifests. Keep
# their committed bytes unchanged on Windows even when core.autocrlf=true.
data/model_freezes/** -text
data/fit_results_decomposed/** -text
data/fit_results_remeasured_geometry/** -text

# Non-protected OptiTrack evidence required to reproduce data processing and
# model training on another workstation.
data/raw_takes/**/*.csv filter=lfs diff=lfs merge=lfs -text
data/processed_takes/**/*.npz filter=lfs diff=lfs merge=lfs -text
